# ─────────────────────────────────────────────────────────────
# Parch — environment
#
# EVERY key below is optional. With an empty .env.local the app boots
# into demo mode: a scripted agent, a file-backed store, simulated
# Prava payments and heuristic trust scores. Add keys to light up the
# real integrations one at a time.
# ─────────────────────────────────────────────────────────────

# ── AI ───────────────────────────────────────────────────────
# Without this, the agent runs from a deterministic script that calls
# the exact same tools. The demo works either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ── Prava (payments) ─────────────────────────────────────────
# Sandbox: https://sandbox.api.prava.space  (sk_test_ / pk_test_ keys)
# Live:    https://api.prava.space          (sk_live_ / pk_live_ keys)
NEXT_PUBLIC_PRAVA_BACKEND_URL=https://sandbox.api.prava.space

# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
MERCHANT_SECRET_KEY=

# Safe for the browser.
NEXT_PUBLIC_PUBLISHABLE_KEY=

# ── Senso (merchant trust) ───────────────────────────────────
# Without this, trust scores come from the local vendor knowledge base.
SENSO_API_KEY=
SENSO_BASE_URL=https://api.senso.ai

# ── Supabase (persistence) ───────────────────────────────────
# Without these, data is stored in .data/parch.json on disk.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Linq (iMessage/SMS approval notifications) ───────────────
# Without these, no text is sent — the approval card in the app still
# works exactly the same.
LINQ_API_KEY=
# Your provisioned Linq number, E.164 format.
LINQ_FROM_NUMBER=
# The founder's phone, E.164 format — where approval texts are sent.
LINQ_TO_NUMBER=
# Only needed once you register a webhook (requires a public HTTPS URL —
# see app/api/linq/webhook/route.ts). Verifies inbound replies are really
# from Linq. Skipped, with a note in the logs, if unset.
LINQ_WEBHOOK_SECRET=
# Used in the "open the app to finish with your passkey" reply text.
# Set this to your real deployed URL in production (e.g. Vercel) — a
# localhost link in a text message is useless to the person reading it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo identity ────────────────────────────────────────────
DEMO_USER_EMAIL=founder@acme.dev
DEMO_COMPANY_NAME=Acme Inc.

# ── Approval integrity ───────────────────────────────────────
# HMAC key used to sign each approval so it can't be replayed or edited
# in transit. Falls back to MERCHANT_SECRET_KEY, then OPENAI_API_KEY, then
# a fixed local-dev string — set this explicitly once you deploy.
APPROVAL_SIGNING_SECRET=
